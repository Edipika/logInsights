{
  "index_patterns": ["logs-*-*"],
  "priority": 200,
  "data_stream": {},
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "timestamp": { "type": "date" },
        "project": { "type": "keyword" },
        "environment": { "type": "keyword" },
        "service": { "type": "keyword" },
        "level": { "type": "keyword" },
        "message": { "type": "text" },
        "userId": { "type": "keyword" },
        "kafka": {
          "properties": {
            "topic": { "type": "keyword" },
            "partition": { "type": "integer" },
            "offset": { "type": "long" },
            "consumer": { "type": "keyword" }
          }
        }
      }
    }
  }
}
