# Empty values fall back to the local defaults shown in the comments

# ─── App ──────────────────────────────────────────────
PORT=3000

# ─── Kafka ────────────────────────────────────────────
KAFKA_BROKER=localhost:9092        # comma-separated for multiple brokers
KAFKA_CLIENT_ID=log-insights
KAFKA_TOPIC=logs-stream
KAFKA_GROUP_ID=logs-group
KAFKAJS_NO_PARTITIONER_WARNING=1   # silences the kafkajs v2 partitioner warning

# ─── Elasticsearch ────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
LOG_RETENTION_DAYS=30              # logs are deleted this many days after their daily rollover

# ─── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=
USE_MOCK_AI=true                   # set to false to use the real OpenAI API

# ─── Slack ────────────────────────────────────────────
SLACK_WEBHOOK_HRMS_PROD=
SLACK_WEBHOOK_DEFAULT=
